# Copy to .env.local. Never commit .env.local.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-5.5
PREVIEW_IMAGE_QUALITY=medium

NEXT_PUBLIC_SITE_URL=https://genfundet.dk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=genfundet-private

# Stripe — test keys until §13 go-live. Set STRIPE_MOBILEPAY_ENABLED=true only when MobilePay is active on the account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MOBILEPAY_ENABLED=false

RESEND_API_KEY=
EMAIL_DOMAIN=genfundet.dk
EMAIL_FROM_LOCAL=

NEXT_PUBLIC_META_PIXEL_ID=

ADMIN_PASSWORD=
# Shared secret between the app and the Netlify background job runner (any long random string). Also protects /api/cron/retention.
JOB_SECRET=
CRON_SECRET=
# Where long jobs run: netlify (background function, default when NETLIFY=true) or inline (in-process, for `next dev` and a plain Node server)
JOB_RUNNER=

DELIVERY_DAYS_MAX=5
CHRISTMAS_START_DATE=2026-11-01
CHRISTMAS_CUTOFF_DATE=2026-12-10
# Hide the "Udkast" stamp on the legal pages once a lawyer has reviewed them
LEGAL_DRAFT=true
