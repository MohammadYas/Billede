# Copy to .env.local. Never commit .env.local.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VISION_MODEL=gpt-5.5
PREVIEW_IMAGE_QUALITY=medium

NEXT_PUBLIC_SITE_URL=https://billedearv.dk
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=genfundet-private

# Stripe — test keys until §13 go-live. Payment methods are chosen in the Stripe Dashboard, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Full access (not send-only) once the inbox is on: admin → Beskeder reads mail to hej@ through Resend receiving
RESEND_API_KEY=
# Signing secret of the Resend webhook (event email.received → /api/webhooks/resend). Empty = inbound mail off.
RESEND_WEBHOOK_SECRET=
EMAIL_DOMAIN=billedearv.dk
# Local part of the sender address; defaults to the local part of the e-mail in founder.md (hej@billedearv.dk)
EMAIL_FROM_LOCAL=
# Where replies and the owner notifications (new payment, change request, lead) go. Defaults to the e-mail in founder.md.
EMAIL_REPLY_TO=
OWNER_EMAIL=

NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API: server-side Purchase and InitiateCheckout, deduplicated with the pixel. Optional test code from Events Manager.
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Meta domain verification (Business Settings → Domains → Meta-tag): only the content value
META_DOMAIN_VERIFICATION=

ADMIN_PASSWORD=
# Shared secret between the app and the Netlify background job runner (any long random string).
# CRON_SECRET protects GET /api/cron/retention and must equal the Supabase Vault secret `billedarv_cron_secret` (the pg_cron job sends it).
JOB_SECRET=
CRON_SECRET=
# Where long jobs run: netlify (background function, default when NETLIFY=true) or inline (in-process, for `next dev` and a plain Node server)
JOB_RUNNER=

# Optional: STRIPE_PRODUCT_IMAGE=false hides the preview on the Checkout page; FINAL_IMAGE_SIZE overrides the print final's output size (default auto).
STRIPE_PRODUCT_IMAGE=
FINAL_IMAGE_SIZE=

DELIVERY_DAYS_MAX=10
# Launch offer: first extra copy of the same photograph in the parcel at 0 kr., for orders up to and including this date. Empty = off.
CAMPAIGN_END_DATE=2026-09-30
# WARNING, 2026-09-12: this value is 2026-10-01 in production while lib/config.ts defaults to 2026-11-14.
# On the earlier date the live site turns itself into a Christmas shop — the hero eyebrow becomes
# "Julegaven 2026 · bestil senest 2. december", the FAQ and the closing line change, and every delivery
# promise on the site becomes "inden jul" instead of "inden 10 hverdage". Nothing is broken by it (the
# promise is true with 62 days to spare, and tests/campaign.test.mts pins the arithmetic), but it is a
# marketing decision that happens by itself on a date nobody is watching. Pick one of the two dates.
CHRISTMAS_START_DATE=2026-10-01
CHRISTMAS_CUTOFF_DATE=2026-12-02
# The legal pages no longer carry a hand-set "Udkast" stamp (LEGAL_DRAFT is gone). They name the seller
# facts that are still marked TODO in assets/founder/founder.md, and clear themselves when those are filled in.
#
# The two small products beside the framed parcel. BOTH halves are required per product — a flag without
# a price stays off, and a price without the flag stays off — so an unapproved price can never reach a
# customer, and either product can be withdrawn without a deploy. Prices set by the owner 2026-09-12.
#
# Loose print, 20×30 cm on matte photo paper, no frame or glass, posted flat between card. File included.
NEXT_PUBLIC_PRINT_ENABLED=true
NEXT_PUBLIC_PRINT_PRICE_DKK=250
# The restored file alone. Nothing is posted, so Stripe is not asked for a delivery address.
NEXT_PUBLIC_DIGITAL_ENABLED=true
NEXT_PUBLIC_DIGITAL_PRICE_DKK=99
# Wording of the primary button on the landing page: A "Se hvad dit billede kan blive til", B "Genskab mit billede", C "Se hvad mit billede kan blive til" (default). FlowOpened logs the letter.
NEXT_PUBLIC_CTA_VARIANT=C
